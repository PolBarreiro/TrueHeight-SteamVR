#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "trueheight-icon-v2.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Pol Barreiro Font"
            VALUE "FileDescription",  "TrueHeight - automatic SteamVR floor height lock"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TrueHeight"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Pol Barreiro Font. All rights reserved."
            VALUE "OriginalFilename", "TrueHeight.exe"
            VALUE "ProductName",      "TrueHeight"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
